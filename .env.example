# ============================================================
# RectoBoost — Environment Variables
# Copy to .env and fill in all values
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Pooled connection — use this for application code (Vercel)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.zvniuvrxgboubaegbclt.supabase.co:5432/postgres?pgbouncer=true
# Direct connection — use for Prisma CLI migrations only
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.zvniuvrxgboubaegbclt.supabase.co:5432/postgres

# ── Authentication ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_64_char_hex_string_here

# ── SMMWIZ (Service Provider) ───────────────────────────────
SMMWIZ_API_KEY=4acce9a49d0fd6ed2865ec099bccd84e
SMMWIZ_API_URL=https://smmwiz.com/api/v2

# ── Tripay (Payment Gateway) ───────────────────────────────
# Get from: https://tripay.co.id/merchant → Settings → API Key
TRIPAY_API_KEY=your_tripay_api_key_here
TRIPAY_PRIVATE_KEY=your_tripay_private_key_here
TRIPAY_MERCHANT_CODE=your_tripay_merchant_code_here

# ── Pricing Configuration ─────────────────────────────────
RECTOBOOST_USD_IDR_RATE=16500
RECTOBOOST_PRICE_MULTIPLIER=5
RECTOBOOST_ROUND_TO_IDR=500
RECTOBOOST_MIN_PRICE_PER_1K=1000

# ── Security ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SECRET=generate_32_char_hex_string_here

# ── Application ───────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# ── Email (Optional — for password reset & welcome emails) ─
# Gmail: use App Password (not your real password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# MAIL_FROM=RectoBoost <noreply@yourdomain.com>

# ── Google OAuth (Optional) ───────────────────────────────
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Seed Script Overrides ─────────────────────────────────
# ADMIN_EMAIL=admin@rectoversomedia.com
# ADMIN_PASSWORD=SabrinaBaby1992!
